extends ../base.pug 

block variables
  - var template = "about"

block content
  main.about
    .about__wrapper 

      .about__sections__wrapper
        section.about_me
          .about__me__wrapper
            p.about__text Mohammad Hammad 
            figure.about__media
              video.about__media__image(src="images/goody.webm" alt="Mohammad Hammad" autoplay muted loop playsinline poster) 
            figure.about__media
              img.about__media__image(src="images/goody.webp" alt="Mohammad Hammad, EREN") 
            p.about__text Creative
            p.about__text Frontend Developer 
            p.about__text From 
            figure.about__media
              img.about__media__image(src="images/flag.jpg" alt="Indian Flag")
            p.about__text  India

        section.about__mobile
          .about__mobile__wrapper
            figure.about__mobile__media(data-portal-image)
              video.about__mobile__image(src="images/goody.webm" alt="Mohammad Hammad" autoplay muted loop playsinline poster)

      section.about__main 
        section.about__heading
          .about__heading__wrapper 
            h1.about__heading__text(data-midTitle) About
            p.about__heading__subtext(data-subTitle)
              | When I'm not shipping code, I'm probably nudging 
              | pixels by half a unit, or starting a sixth side 
              | project I don't need
